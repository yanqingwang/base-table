.container { padding: 32rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 36rpx 28rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.title { font-size: 38rpx; font-weight: 600; }
.desc { font-size: 26rpx; color: #666; margin: 12rpx 0 24rpx; line-height: 1.5; }
.input { border: 1rpx solid #ddd; border-radius: 12rpx; padding: 20rpx; font-size: 30rpx; letter-spacing: 2rpx; }
.btn.primary { background: #5b5fc7; color: #fff; border-radius: 12rpx; font-size: 32rpx; margin-top: 24rpx; }
.note { font-size: 24rpx; color: #999; margin-top: 16rpx; text-align: center; }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; }
.dialog { background: #fff; border-radius: 16rpx; padding: 40rpx; width: 560rpx; text-align: center; }
.ok { font-size: 40rpx; font-weight: 700; color: #1a9d5a; margin-bottom: 20rpx; }
.line { font-size: 28rpx; color: #555; margin-bottom: 10rpx; }
.dialog .btn { margin-top: 24rpx; }
