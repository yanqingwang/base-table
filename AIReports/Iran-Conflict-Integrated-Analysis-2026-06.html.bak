<tr><td>全球：国家应避免卷入</td><td>—</td><td>—</td><td><strong>81%</strong></td><td>Ipsos 5.5</td></tr>
<tr><td>全球：归咎美以挑起战争</td><td>—</td><td><strong>80%</strong></td><td>—</td><td>Gallup Intl 4.7</td></tr>
<tr><td>全球：美国将产生正面影响</td><td>—</td><td>—</td><td><strong>39%</strong></td><td>Ipsos 5.5</td></tr>
<tr><td>全球：中国将产生正面影响</td><td>—</td><td>—</td><td><strong>50%</strong></td><td>Ipsos 5.5</td></tr>
<tr><td>全球：高油价"不值得"</td><td>—</td><td>—</td><td><strong>70%</strong></td><td>Ipsos 5.5</td></tr>
