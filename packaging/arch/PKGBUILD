# Maintainer: Base Table
pkgname=base-table
pkgver=0.1.0
pkgrel=1
pkgdesc="Local-first multidimensional table desktop app"
arch=('x86_64')
url="https://github.com/base-table/base-table"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'librsvg')
makedepends=()
source=()
sha256sums=()

package() {
  local project_root="${startdir}/../.."

  install -Dm755 "${project_root}/src-tauri/target/release/base-table" \
    "${pkgdir}/usr/bin/base-table"

  install -Dm644 "${project_root}/src-tauri/icons/icon.png" \
    "${pkgdir}/usr/share/icons/hicolor/32x32/apps/base-table.png"

  install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/base-table.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Base Table
Comment=Local-first multidimensional table desktop app
Exec=base-table
Icon=base-table
Terminal=false
Categories=Office;Database;
StartupNotify=true
EOF

  install -Dm644 "${project_root}/LICENSE" \
    "${pkgdir}/usr/share/licenses/base-table/LICENSE"
}
