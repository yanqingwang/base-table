  .stat-row { display: flex; gap: 12px; flex-wrap: wrap; margin: 20px 0; }
  .stat { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 14px 18px; text-align: center; min-width: 100px; flex: 1; }
