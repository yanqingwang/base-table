/* pages/profile/profile.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f7;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #5b5fc7, #7a7fdb);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  font-size: 50rpx;
}

.user-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.user-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

/* 同步状态 */
.sync-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.sync-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1d1d1f;
}

.sync-time {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.sync-pending {
  display: block;
  font-size: 22rpx;
  color: #e74c3c;
  margin-top: 4rpx;
}

.sync-btn {
  background: #eef0ff;
  color: #5b5fc7;
  font-size: 26rpx;
  border-radius: 10rpx;
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
}

.sync-btn.force {
  background: #fdf1e3;
  color: #e67e22;
}

.sync-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.sync-btn::after { border: none; }

/* 统计 */
.stats-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #5b5fc7;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: #eee;
}

/* 菜单 */
.menu-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child { border-bottom: none; }

.menu-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #1d1d1f;
}

.menu-text.danger { color: #e74c3c; }

.menu-value {
  font-size: 24rpx;
  color: #999;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* ⚠️ 谨慎操作区块 */
.danger-zone {
  border: 2rpx solid #e74c3c;
}

.menu-section-title {
  font-size: 24rpx;
  color: #e74c3c;
  font-weight: 600;
  padding: 20rpx 0 4rpx;
}

.tip {
  text-align: center;
  padding: 40rpx 0;
  color: #bbb;
  font-size: 24rpx;
}

/* 编辑按钮 */
.edit-btn {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
}

/* 编辑资料弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
}

.modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}

.edit-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar-btn {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  padding: 0;
  background: #f0f0f4;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-btn::after { border: none; }

.edit-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
}

.edit-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.avatar-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  background: #f8f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 30rpx;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  border-radius: 12rpx;
}

.modal-btn.cancel {
  background: #f0f0f4;
  color: #666;
}

.modal-btn.confirm {
  background: #5b5fc7;
  color: #fff;
}

.modal-btn::after { border: none; }
