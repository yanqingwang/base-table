/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f7;
  padding: 16rpx 24rpx 160rpx;
  box-sizing: border-box;
}

/* 头部 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 24rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef0ff;
  font-size: 40rpx;
}

.hello {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.sync-time {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 全局建议卡片 */
.suggestion-card {
  background: linear-gradient(135deg, #5b5fc7, #7a7fdb);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(91, 95, 199, 0.3);
}

.suggestion-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
}

.suggestion-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

.suggestion-msg {
  font-size: 26rpx;
  color: #eef0ff;
  margin-top: 16rpx;
  text-align: center;
}

/* 到期提醒 */
.expiring-card {
  background: #fff5f5;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #fde2e2;
}

.card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #e74c3c;
  margin-bottom: 12rpx;
}

.expiring-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #fde2e2;
}

.expiring-item:last-child { border-bottom: none; }

.expiring-name {
  display: block;
  font-size: 26rpx;
  color: #1d1d1f;
}

.expiring-sub {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.expiring-badge {
  background: #e74c3c;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 错误/加载/空 */
.error-box {
  background: #fdecec;
  color: #e74c3c;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.loading-box {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon { font-size: 80rpx; }
.empty-text { color: #999; font-size: 28rpx; margin-top: 20rpx; }

.empty-btn {
  margin-top: 32rpx;
  background: #5b5fc7;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 12rpx 48rpx;
}

.empty-btn::after { border: none; }

/* 配额列表 */
.quota-section { margin-top: 8rpx; }

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 16rpx;
}

.quota-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.quota-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.quota-merchant {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.quota-item {
  display: block;
  font-size: 24rpx;
  color: #5b5fc7;
  margin-top: 4rpx;
}

.quota-remain {
  font-size: 28rpx;
  color: #5b5fc7;
  font-weight: 600;
}

.progress-track {
  height: 14rpx;
  background: #eee;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #5b5fc7, #7a7fdb);
  border-radius: 8rpx;
}

.quota-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.quota-expire { font-size: 24rpx; color: #999; }
.quota-amount { font-size: 24rpx; color: #e67e22; font-weight: 600; }

.quick-checkin-btn {
  margin-top: 16rpx;
  background: #eef0ff;
  color: #5b5fc7;
  font-size: 26rpx;
  border-radius: 10rpx;
  height: 64rpx;
  line-height: 64rpx;
}

.quick-checkin-btn::after { border: none; }

/* 新增按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #5b5fc7;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(91, 95, 199, 0.4);
  z-index: 100;
}

.fab-icon {
  color: #fff;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}
