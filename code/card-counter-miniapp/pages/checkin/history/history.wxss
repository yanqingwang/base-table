/* pages/checkin/history/history.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f7;
  padding: 24rpx;
  box-sizing: border-box;
}

.filter-bar {
  margin-bottom: 20rpx;
}

.filter-btn {
  display: inline-block;
  background: #fff;
  color: #5b5fc7;
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border-radius: 10rpx;
}

.loading-box {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon { font-size: 80rpx; }
.empty-text { color: #999; font-size: 28rpx; margin-top: 20rpx; }

.list {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
}

.item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.item:last-child { border-bottom: none; }

.item-merchant {
  display: block;
  font-size: 30rpx;
  color: #1d1d1f;
}

.item-date {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.item-date.date-small {
  font-size: 22rpx;
  color: #e67e22;
}

.item-edit-log {
  display: block;
  font-size: 22rpx;
  color: #f39c12;
  margin-top: 4rpx;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.item-deduct {
  font-size: 30rpx;
  color: #e74c3c;
  font-weight: 600;
}

.edit-btn {
  font-size: 24rpx;
  color: #5b5fc7;
  border: 1rpx solid #5b5fc7;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
