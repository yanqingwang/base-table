.container { padding: 32rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 36rpx 28rpx; margin-bottom: 28rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.title { font-size: 38rpx; font-weight: 600; }
.price { font-size: 64rpx; font-weight: 700; color: #e4393c; margin: 16rpx 0; }
.price .unit { font-size: 28rpx; color: #888; margin-left: 6rpx; }
.meta { font-size: 26rpx; color: #666; }
.refund { font-size: 24rpx; color: #999; margin-top: 16rpx; line-height: 1.5; }
.btn.primary { background: #5b5fc7; color: #fff; border-radius: 12rpx; font-size: 32rpx; }
.note { font-size: 24rpx; color: #999; margin-top: 16rpx; text-align: center; }
.empty { color: #999; text-align: center; margin-top: 120rpx; font-size: 28rpx; }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; }
.dialog { background: #fff; border-radius: 16rpx; padding: 40rpx; width: 560rpx; text-align: center; }
.ok { font-size: 40rpx; font-weight: 700; color: #1a9d5a; margin-bottom: 20rpx; }
.line { font-size: 28rpx; color: #555; margin-bottom: 10rpx; }
.dialog .btn { margin-top: 24rpx; }
