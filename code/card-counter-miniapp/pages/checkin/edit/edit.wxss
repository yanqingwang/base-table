.page { padding: 24rpx; }
.loading-box { text-align: center; color: #999; padding: 80rpx 0; }
.edit-card { background: #fff; border-radius: 16rpx; padding: 8rpx 24rpx; }
.edit-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.edit-label { width: 120rpx; color: #999; font-size: 28rpx; flex-shrink: 0; }
.edit-value { flex: 1; font-size: 28rpx; color: #333; }
.date-small { font-size: 22rpx; color: #e67e22; }
.date-picker { display: inline-flex; align-items: center; font-size: 28rpx; color: #333; }
.edit-input { flex: 1; font-size: 28rpx; color: #333; border-bottom: 1rpx solid #e5e5e5; padding: 8rpx 0; }
.edit-logs { margin-top: 16rpx; background: #fafafa; border-radius: 12rpx; padding: 16rpx; }
.edit-logs-title { font-size: 24rpx; color: #999; display: block; margin-bottom: 8rpx; }
.edit-log-item { font-size: 24rpx; color: #888; display: block; line-height: 1.6; }
.edit-actions { margin-top: 32rpx; display: flex; gap: 24rpx; }
.act-btn { flex: 1; border-radius: 12rpx; font-size: 28rpx; padding: 20rpx 0; line-height: 1.4; }
.act-btn.save { background: #5b5fc7; color: #fff; }
.act-btn.save[disabled] { background: #c5c7e8; color: #fff; }
.act-btn.revoke { background: #fff; color: #e74c3c; border: 1rpx solid #e74c3c; }
