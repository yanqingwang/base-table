  td { padding: 10px 8px; border-bottom: 1px solid #21262d; vertical-align: middle; }
  tr:hover { background: #161b22; }

  .box { background: #161b22; border-left: 3px solid #f0883e; padding: 16px 20px; margin: 20px 0; border-radius: 0 8px 8px 0; }
  .box strong { color: #f0883e; }
  .box.blue { border-left-color: #58a6ff; }
  .box.red { border-left-color: #f85149; }
  .box.green { border-left-color: #3fb950; }

  .tag { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; margin-right: 4px; }
  .tag.green { background: #1b3a1f; color: #3fb950; }
  .tag.red { background: #3a1b1b; color: #f85149; }
  .tag.yellow { background: #3a2f1b; color: #d29922; }
  .tag.gray { background: #1b1f24; color: #8b949e; }
  .tag.blue { background: #1b2d3a; color: #58a6ff; }

  .tl { position: relative; padding-left: 30px; margin: 20px 0; }
  .tl::before { content: ''; position: absolute; left: 12px; top: 0; bottom: 0; width: 2px; background: #30363d; }
  .tl-i { position: relative; margin-bottom: 16px; }
  .tl-i::before { content: ''; position: absolute; left: -24px; top: 6px; width: 12px; height: 12px; border-radius: 50%; background: #58a6ff; border: 2px solid #0d1117; }
  .tl-i.major::before { background: #f85149; width: 16px; height: 16px; left: -26px; top: 4px; }
  .tl-i.done::before { background: #3fb950; }
  .tl-i.diplo::before { background: #f0883e; }
  .tl-date { color: #8b949e; font-size: 12px; font-weight: 600; }
  .tl-title { color: #c9d1d9; font-weight: 600; font-size: 14px; }
  .tl-desc { color: #8b949e; font-size: 13px; margin-top: 2px; }

  .ph { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 10px; margin: 16px 0; }
  .ph-c { border-radius: 8px; padding: 12px 14px; border: 1px solid #30363d; }
  .ph-c.p1 { background: #2d1a1a; border-color: #f85149; }
  .ph-c.p2 { background: #2d2a1a; border-color: #d29922; }
  .ph-c.p3 { background: #1a2d1a; border-color: #3fb950; }
  .ph-c.p4 { background: #1b2d3a; border-color: #58a6ff; }
  .ph-c h4 { margin-bottom: 4px; color: #c9d1d9; }
  .ph-c p { font-size: 12px; line-height: 1.5; margin-top: 4px; color: #8b949e; }

  .callout { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 14px 18px; margin: 14px 0; }
  .callout .src { font-size: 11px; color: #484f58; margin-top: 6px; }

  .grid3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; margin: 12px 0; }
  .gc { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 12px 16px; }
  .gc h4 { color: #d2a8ff; font-size: 14px; margin-bottom: 6px; text-transform: none; letter-spacing: 0; }
  .gc p { color: #c9d1d9; font-size: 13px; line-height: 1.5; }

  .bp { display: flex; align-items: center; margin: 5px 0; }
  .bp-l { width: 110px; font-size: 13px; color: #c9d1d9; }
  .bp-t { flex: 1; height: 20px; background: #21262d; border-radius: 4px; overflow: hidden; }
  .bp-f { height: 100%; border-radius: 4px; }
  .bp-v { width: 60px; text-align: right; font-size: 13px; font-weight: 600; }

  .ft { margin-top: 50px; padding-top: 20px; border-top: 1px solid #30363d; color: #484f58; font-size: 12px; text-align: center; }

  @media (max-width: 768px) {
    .ph { grid-template-columns: 1fr 1fr; }
    .grid3 { grid-template-columns: 1fr; }
    .stat-row { flex-direction: column; }
    table { font-size: 12px; }
    body { padding: 10px; }
  }
</style>
