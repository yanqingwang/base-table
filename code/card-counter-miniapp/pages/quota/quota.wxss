/* pages/quota/quota.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f7;
  padding: 24rpx;
  box-sizing: border-box;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-item.half {
  flex: 1;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  background: #f8f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 30rpx;
  color: #1d1d1f;
}

.picker-value.placeholder {
  color: #bbb;
}

.save-btn {
  margin-top: 40rpx;
  background: #5b5fc7;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.save-btn::after { border: none; }

.del-btn {
  margin-top: 20rpx;
  background: #fdecec;
  color: #e74c3c;
  border-radius: 12rpx;
  font-size: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.del-btn::after { border: none; }
