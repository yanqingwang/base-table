/* pages/login/login.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f7;
  padding: 60rpx 48rpx;
  box-sizing: border-box;
}

/* Logo */
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo-icon {
  font-size: 100rpx;
}

.logo-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #5b5fc7;
  margin-top: 16rpx;
}

.logo-sub {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 错误提示 */
.error-box {
  background: #fdecec;
  color: #e74c3c;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

/* 表单 */
.form-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  background: #f8f8fa;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  color: #1d1d1f;
}

.submit-btn {
  margin-top: 16rpx;
  background: #5b5fc7;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.submit-btn::after { border: none; }

.switch-link {
  text-align: center;
  color: #5b5fc7;
  font-size: 26rpx;
  margin-top: 24rpx;
}

/* 微信登录 */
.wechat-section {
  margin-top: 40rpx;
}

.divider {
  display: flex;
  align-items: center;
  color: #bbb;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.divider::before, .divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #e0e0e0;
  margin: 0 20rpx;
}

.wechat-btn {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  height: 84rpx;
  line-height: 84rpx;
}

.wechat-btn::after { border: none; }
