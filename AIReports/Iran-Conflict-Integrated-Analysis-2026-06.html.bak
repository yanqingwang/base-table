<tr><td>🇫🇷 法语</td><td><span class="tag gray">0</span></td><td><span class="tag gray">0</span></td><td><span class="tag yellow">-1</span></td><td><span class="tag yellow">-1</span></td><td>批评固化的战略焦虑</td></tr>
