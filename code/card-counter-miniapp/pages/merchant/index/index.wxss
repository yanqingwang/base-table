.container { padding: 32rpx; }
.panel { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; }
.panel-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.field { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.label { font-size: 26rpx; color: #666; width: 160rpx; }
.input { flex: 1; font-size: 28rpx; }
.btn.primary { background: #5b5fc7; color: #fff; border-radius: 12rpx; margin-top: 24rpx; }
.btn.small { background: #5b5fc7; color: #fff; font-size: 26rpx; padding: 8rpx 28rpx; margin: 0 16rpx 0 0; line-height: 1.8; border-radius: 12rpx; }
.btn.line { background: #fff; color: #5b5fc7; border: 2rpx solid #5b5fc7; border-radius: 12rpx; }
.btn.ghost { background: #fff; color: #333; border: 2rpx solid #ddd; border-radius: 12rpx; }
.actions { display: flex; flex-wrap: wrap; }
.issue-code { font-size: 40rpx; letter-spacing: 6rpx; color: #5b5fc7; text-align: center; margin: 12rpx 0 20rpx; }
.hint { font-size: 22rpx; color: #999; margin-top: 12rpx; line-height: 1.6; }
.row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #f5f5f5; font-size: 26rpx; }
.status { font-size: 22rpx; padding: 2rpx 12rpx; border-radius: 16rpx; background: #eee; color: #666; }
.status.active { background: #e6f7ee; color: #1a9d5a; }
.status.used_up, .status.expired, .status.voided { background: #fdeaea; color: #c0392b; }
.remain { color: #555; }
.empty { color: #999; font-size: 26rpx; text-align: center; padding: 20rpx 0; }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: flex-end; }
.sheet { background: #fff; width: 100%; padding: 40rpx; border-radius: 24rpx 24rpx 0 0; }
.sheet-title { font-size: 30rpx; font-weight: 600; margin-bottom: 24rpx; }
.picker { background: #f4f4fb; border-radius: 12rpx; padding: 24rpx; font-size: 28rpx; margin-bottom: 24rpx; }
